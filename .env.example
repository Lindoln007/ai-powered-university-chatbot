# Copy this file to .env and adjust the values. Never commit .env.

# --- Django ---
DJANGO_DEBUG=true
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Blantyre

# --- PostgreSQL ---
DB_NAME=university_chatbot
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
# Connection pool (avoids ~50 ms per request for new connections on Windows)
DB_POOL=true
DB_POOL_MAX_SIZE=4

# --- Frontend integration (comma separated origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=

# --- NLP model (runs locally, no external API) ---
NLP_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# NLP_MODEL_CACHE_DIR defaults to ./ml_models
NLP_OFFLINE=false
NLP_DEVICE=cpu
NLP_BATCH_SIZE=32
# CPU threads for PyTorch (0 = automatic, max 4; suits a 4-core Intel Core i5 laptop)
NLP_TORCH_THREADS=0
# Load the model in the background when the server starts
NLP_PRELOAD_MODEL=true
NLP_INTENT_THRESHOLD=0.40

# --- Chatbot behaviour ---
CHATBOT_DEMO_MODE=true
# Initial experimental value was 0.45; 0.50 chosen with: python manage.py evaluate_retrieval
CHATBOT_SIMILARITY_THRESHOLD=0.50
CHATBOT_CLARIFICATION_MARGIN=0.03
CHATBOT_HIGH_CONFIDENCE=0.75
CHATBOT_MAX_QUESTION_LENGTH=500
CHATBOT_TOP_K=5
# Weight of the previous topic when resolving follow-up questions ("What about the fees?")
CHATBOT_CONTEXT_WEIGHT=0.35
KNOWLEDGE_SEARCH_MIN_SCORE=0.30
KNOWLEDGE_AUTO_EMBED=true

# --- Rate limits ---
THROTTLE_ANON=120/minute
THROTTLE_USER=300/minute
THROTTLE_CHAT_MESSAGE=30/minute
THROTTLE_AUTH=10/minute
THROTTLE_FEEDBACK=30/minute
